modules = ["nodejs-24", "postgresql-16", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
PLANB_RAILWAY_URL = "https://workspaceapi-server-production-01d8.up.railway.app"
PLANB_REPLIT_URL = "https://hello-hola.replit.app"
TELEGRAM_CHAT_ID = "5065014534"
MAKE_FORWARD_URL = "https://hook.us2.make.com/fei3t1kyccnamqbfbi3ru3uytyi7qe97"
